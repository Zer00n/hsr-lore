{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hsr-lore/schema/relation.schema.json",
  "title": "Relation",
  "description": "关系 — 两个实体之间的有向关联",
  "type": "object",
  "required": ["relation_id", "subject_id", "predicate", "object_id", "claim_type", "confidence", "citations", "source_volume"],
  "properties": {
    "relation_id": {
      "type": "string",
      "description": "ID 格式 REL:{hash12}",
      "pattern": "^REL:[a-f0-9]{12}$"
    },
    "subject_id": {
      "type": "string",
      "description": "主实体 ID"
    },
    "predicate": {
      "type": "string",
      "description": "关系谓词，必须在受控词表内"
    },
    "object_id": {
      "type": "string",
      "description": "宾实体 ID"
    },
    "qualifiers": {
      "type": "object",
      "properties": {
        "native_term": { "type": "string" },
        "status": { "type": "string" },
        "since_event": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    },
    "claim_type": { "type": "string", "enum": ["fact", "interpretation"] },
    "confidence": { "type": "string", "enum": ["attested", "inferred", "disputed"] },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "citation.schema.json" }
    },
    "source_volume": {
      "type": "string",
      "enum": ["lore", "books", "characters", "narrative", "dialogue", "artifacts", "rogue"]
    }
  },
  "additionalProperties": false
}