---
import Base from '../layouts/Base.astro';
import SiteApp from '../components/SiteApp.jsx';
---

<Base>
  <section class="hero">
    <div class="hero-overlay" aria-hidden="true" />
    <div class="hero-content">
      <h1>「崩坏：星穹铁道」世界观考据站</h1>
      <p>
        穿梭银河，逐句追溯——每一条结论，都回响着原作的对白与叙事。
      </p>
    </div>
  </section>

  <noscript>
    <div class="noscript-notice">
      <p>⚠ 此页面依赖 JavaScript 加载数据并渲染交互式考据视图。</p>
      <p>请启用 JavaScript 后刷新。</p>
    </div>
  </noscript>

  <SiteApp client:load />
</Base>

<style>
  .hero {
    position: relative;
    margin-bottom: var(--space-6);
    padding: var(--space-12) 0;
    border-bottom: 1px solid var(--border);
    background: url('/images/hero-bg.jpg') center/cover no-repeat;
    min-height: 300px;
    display: flex;
    align-items: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(18,16,13,0.6) 0%, rgba(18,16,13,0.85) 50%, var(--bg-base) 100%);
    z-index: 0;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }
  .hero h1 {
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }
  .hero p {
    max-width: 640px;
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }
  .noscript-notice {
    padding: var(--space-4) var(--space-5);
    background: var(--bg-elevated);
    border: 1px solid var(--warning);
    border-radius: var(--radius-md);
    color: var(--warning);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }
  .noscript-notice p { margin-bottom: var(--space-2); }
</style>
