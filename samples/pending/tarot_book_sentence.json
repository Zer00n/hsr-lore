[
  {
    "source": "TarotBookSentence",
    "id": 10010101,
    "field": "Sentence",
    "text": "在士兵之间，久负盛名的城邦……\\n悬锋，\\n是每一个战士的向往之地。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010102,
    "field": "Sentence",
    "text": "成为悬锋祭典的冠军，\\n是千里挑一…不，万里挑一的殊荣。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010103,
    "field": "Sentence",
    "text": "<i><color=#9e5738>「那只是杀戮，毫无荣耀可言。」</color></i>\\n一个男人挡在我面前。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010104,
    "field": "Sentence",
    "text": "他名叫迈德漠斯……\\n万敌。\\n是悬锋的王储。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010201,
    "field": "Sentence",
    "text": "男人寡言少语，\\n但他的事迹广为流传。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010202,
    "field": "Sentence",
    "text": "是不可思议的故事，\\n人们说，"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010203,
    "field": "Sentence",
    "text": "<i><color=#9a7d62>「这样都能活下来…连死神都抛弃了他啊。」</color></i>"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010204,
    "field": "Sentence",
    "text": "不死的身躯。\\n属于男人的天赐。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010212,
    "field": "Sentence",
    "text": "出生就被生父扔下悬崖，\\n坠入冥海，漂流九年之久。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010214,
    "field": "Sentence",
    "text": "就像翁法罗斯的每一位黄金裔…\\n是写作<color=#9e5738>「诅咒」</color>的祝福。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010301,
    "field": "Sentence",
    "text": "无言的男人坐在桌边，\\n等待我先开口。\\n杯中盛满的，是<color=#9e5738>猩红的液体</color>。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010302,
    "field": "Sentence",
    "text": "听说是悬锋城的传统。\\n以<color=#9e5738>鲜血</color>滋养身躯。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010303,
    "field": "Sentence",
    "text": "<i><color=#9e5738>「自以为是的野史学家。」</color></i>\\n被看穿了……\\n他的眼神像狮子一样锐利。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010304,
    "field": "Sentence",
    "text": "<i><color=#9e5738>「这是石榴汁。」</color></i>\\n男人嗤之以鼻。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010312,
    "field": "Sentence",
    "text": "在广为流传的故事里……\\n他们掠走战场上的每一具尸体。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010401,
    "field": "Sentence",
    "text": "野史之所以为野史，\\n是因为悬锋城消失已久。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010402,
    "field": "Sentence",
    "text": "人们的神陷入癫狂，\\n城邦也迷失在雾中。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010403,
    "field": "Sentence",
    "text": "传闻，悬锋城的末日之战，\\n男人也投身沙场。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010404,
    "field": "Sentence",
    "text": "横扫千军，浴血鏖战，\\n用长矛贯穿了敌王——"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010405,
    "field": "Sentence",
    "text": "只是那矛头……\\n指向<color=#9e5738>自己的故乡</color>。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010501,
    "field": "Sentence",
    "text": "议论声起，\\n男人起身离去。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010502,
    "field": "Sentence",
    "text": "流言的真相，\\n他从来只用背影讲述。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010503,
    "field": "Sentence",
    "text": "那是经受千难百死，\\n却不曾留下一道伤痕的脊背。"
  },
  {
    "source": "TarotBookSentence",
    "id": 10010504,
    "field": "Sentence",
    "text": "迈德漠斯，往日的英雄……\\n他是悬锋的叛徒，\\n<color=#9e5738>弑父的王储。</color>"
  },
  {
    "source": "TarotBookSentence",
    "id": 7010101,
    "field": "Sentence",
    "text": "在翁法罗斯，\\n随处可见无名的造像。"
  },
  {
    "source": "TarotBookSentence",
    "id": 7010102,
    "field": "Sentence",
    "text": "据说它们的原型，\\n来自创世之初，天父手中的泥像。"
  },
  {
    "source": "TarotBookSentence",
    "id": 7010103,
    "field": "Sentence",
    "text": "它为自己打造化身……\\n赐予生命的呼吸，\\n令金色的神血流淌。"
  },
  {
    "source": "TarotBookSentence",
    "id": 7010104,
    "field": "Sentence",
    "text": "从此——\\n最初的「人」行走大地，"
  },
  {
    "source": "TarotBookSentence",
    "id": 7010114,
    "field": "Sentence",
    "text": "蒙恩众神的垂怜，\\n感悟此世的哀伤。"
  },
  {
    "source": "TarotBookSentence",
    "id": 7010201,
    "field": "Sentence",
    "text": "圣城的居民，\\n在造像前看见一个男人。"
  }
]